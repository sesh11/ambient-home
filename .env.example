OPENAI_API_KEY=
AMBIENT_LIVE_MODEL=gpt-live-1
AMBIENT_BACKEND_MODEL=gpt-5.6-terra
AMBIENT_VISION_MODEL=
AMBIENT_VOICE=ballad
AMBIENT_LOG_LEVEL=INFO
AMBIENT_WAKE_WORD=hey_jarvis
# Set to hey_alfred to use the bundled custom model.
AMBIENT_WAKE_THRESHOLD=0.5
AMBIENT_PREROLL_SECONDS=2.0
AMBIENT_IDLE_TIMEOUT_S=60
AMBIENT_MAX_SESSION_S=600
AMBIENT_DAILY_BUDGET_S=3600
AMBIENT_DATA_DIR=~/.ambient-home
AMBIENT_TRANSCRIPT_FINALIZE_S=1.0
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai
AMBIENT_DEVIN_MAX_ACU=5
AMBIENT_JOB_POLL_S=20
AMBIENT_UI_HOST=127.0.0.1
AMBIENT_UI_PORT=8765
AMBIENT_MIC_AUTORECOVER=true

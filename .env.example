OPENAI_API_KEY=
AMBIENT_LIVE_MODEL=gpt-live-1
AMBIENT_BACKEND_MODEL=gpt-5.6-terra
AMBIENT_VISION_MODEL=
AMBIENT_VOICE=ballad
AMBIENT_LOG_LEVEL=INFO
AMBIENT_WAKE_WORD=hey_jarvis
# Set to hey_alfred to use the bundled custom model.
AMBIENT_WAKE_THRESHOLD=0.5
AMBIENT_PREROLL_SECONDS=2.0
AMBIENT_IDLE_TIMEOUT_S=60
AMBIENT_MAX_SESSION_S=600
AMBIENT_DAILY_BUDGET_S=3600
AMBIENT_DATA_DIR=~/.ambient-home
AMBIENT_TRANSCRIPT_FINALIZE_S=1.0
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai
AMBIENT_DEVIN_MAX_ACU=5
AMBIENT_JOB_POLL_S=20
AMBIENT_UI_HOST=127.0.0.1
AMBIENT_UI_PORT=8765
AMBIENT_MIC_AUTORECOVER=true
AMBIENT_DAEMON_STATUS_URL=http://127.0.0.1:8000/api/daemon/status
AMBIENT_DAEMON_WAIT_S=60
AMBIENT_DAEMON_WATCHDOG_S=5
AMBIENT_DAEMON_WATCHDOG_FAILURES=3
# Local structured event directory (default: ~/Library/Logs/ambient-home/events).
AMBIENT_EVENTS_DIR=~/Library/Logs/ambient-home/events
# Retention for local event day files.
AMBIENT_EVENT_RETENTION_DAYS=14
# App heartbeat interval in seconds.
AMBIENT_HEARTBEAT_S=300
# Incident detector implementation: rules.
AMBIENT_DETECTOR=rules
# Optional TOML rules file override.
AMBIENT_INCIDENT_RULES=
# Incident evaluation lookback in seconds.
AMBIENT_INCIDENT_LOOKBACK_S=86400
# Factory step 3: file incidents and voice fix/feature requests as GitHub issues (off by default).
AMBIENT_FACTORY_REPORT=false
# Fine-grained token limited to the factory repo with Issues: read and write only.
AMBIENT_GITHUB_TOKEN=
AMBIENT_FACTORY_REPO=sesh11/ambient-home
# Most new issues per day, per kind (incidents, voice requests).
AMBIENT_FACTORY_MAX_NEW_ISSUES_PER_DAY=5
